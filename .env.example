# ICT web UI — environment for docker compose.
# Copy to .env and fill in real values. `.env` is git-ignored.
#
# Only the JENKINS_* trio matters for the dispatch endpoint to work.
# Without them the backend still starts, serves the UI, and returns
# HTTP 503 on POST /api/v1/jenkins/dispatch — the frontend surfaces
# this as a clean "Jenkins dispatch is not configured" error.

# --- Jenkins farm (required for dispatches) ---
JENKINS_URL=https://cje-pg-prod01.devtools.intel.com/nex-cisv-devops02
JENKINS_USER=your-idsid
JENKINS_TOKEN=change-me
# Defaults to ict-farm/workers if unset — matches the code default.
JENKINS_WORKERS_PATH=ict-farm/workers

# --- Frontend → backend wiring (envsubst'd into nginx upstream) ---
# The frontend container's nginx renders `upstream backend { server ${BACKEND_URL}; }`
# from this value at start. For the compose topology below, the sibling
# service name is enough — override for CaaS deployments where the two
# containers don't share a docker-compose network (e.g. set to the
# routable DNS name + port of the backend service).
BACKEND_URL=backend:8080

# --- Backend → package-search microservice wiring ---
# When set, the backend reverse-proxies /api/v1/packages to this URL's
# /search endpoint. Compose defaults it to the sibling `pkgsvc` service.
# In CaaS deployments where the two containers live on different networks
# with different DNS, override to the routable host:port of ict-pkgsvc
# (e.g. http://ict-pkgsvc.internal:9090 or the K8s Service DNS name).
# Leave unset to fall back to the embedded shard scan (migration
# safety net, removed in step 4).
PKGSVC_URL=http://pkgsvc:9090

# Bearer token for POST /admin/refresh on ict-pkgsvc — required to
# manually kick a crawl. Empty disables the endpoint (returns 501).
PKGSVC_ADMIN_TOKEN=change-me

# Flip to "true" once step 2 of the migration is ready (live crawler).
# Left "false" here to match the safe default in the compose file.
PKGSVC_CRAWLER_ENABLED=false

# --- Intel network proxy (only needed inside the corporate network) ---
# Uncomment on Intel-network hosts; leave commented on public networks.
# HTTP_PROXY=http://proxy-dmz.intel.com:912
# HTTPS_PROXY=http://proxy-dmz.intel.com:912
# NO_PROXY=localhost,127.0.0.1,.intel.com
